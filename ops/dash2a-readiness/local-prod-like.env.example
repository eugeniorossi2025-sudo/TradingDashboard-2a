# DASH2A local prod-like (no secrets committed)
# Use: restart-app-safe.ps1 -Run
#
# Flusso: Frontend localhost:5001 -> WebApi localhost:5299 -> DB Dash2A_LocalProdLike
# Decider 51.178.16.37: SOLO /api/decider/config e /api/decider/health (nessun sync verso DB locale)

# Vue -> WebApi locale ONLY (never 51.83.159.175 in local frontend)
WEBAPI_URL=http://localhost:5299
VITE_API_BASE_URL=http://localhost:5299
FRONTEND_URL=http://localhost:5001

# WebApi local
ASPNETCORE_ENVIRONMENT=LocalProdLike
ASPNETCORE_URLS=http://localhost:5299
ConnectionStrings__DefaultConnection=Server=(localdb)\MSSQLLocalDB;Database=Dash2A_LocalProdLike;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True;

# Decider remoto — diagnostica WebApi (config/health probe su /api/proactive)
Decider__Enabled=true
Decider__Mode=Remote
Decider__BaseUrl=http://51.178.16.37
Decider__ApiBasePath=/api/proactive
