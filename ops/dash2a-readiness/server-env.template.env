# DASH2A server environment template
# Copy to the server secret/env mechanism only. Do not commit real values.
# RDP access secret, when needed for controlled access, is stored in GitHub Actions as DASH2A_RDP_PASSWORD.
# Do not copy or print the actual RDP password here.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:TODO_PORT

# WebApi database
ConnectionStrings__DefaultConnection=Server=TODO_HOST,1433;Database=TODO_DB;User Id=TODO_USER;Password=TODO_PASSWORD;Encrypt=False;TrustServerCertificate=True;

# JWT
Jwt__Key=TODO_STRONG_RANDOM_KEY
Jwt__Issuer=WebApi
Jwt__Audience=WebApiUsers
Jwt__ExpirationMinutes=60

# Admin bootstrap/reset
Admin__Username=admin
Admin__Password=TODO_STRONG_ADMIN_PASSWORD
Admin__Email=TODO_ADMIN_EMAIL

# SMTP / notifications
Smtp__Host=TODO_SMTP_HOST
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__Username=TODO_SMTP_USER
Smtp__Password=TODO_SMTP_PASSWORD
Smtp__From=TODO_FROM_EMAIL

# Optional telemetry
ApplicationInsights__ConnectionString=

# Frontend build-time API target
VITE_API_BASE_URL=http://51.83.159.175
